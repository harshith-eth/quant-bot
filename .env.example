# ===== SOLANA CONFIGURATION =====
# Your Solana wallet private key (base58 encoded)
# ⚠️ WARNING: Never share this or commit it to version control!
PRIVATE_KEY=your_wallet_private_key_here

# Primary RPC endpoint - Use Helius for best performance
RPC_ENDPOINT=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key

# Backup RPC endpoints (optional but recommended)
RPC_ENDPOINT_BACKUP=https://api.mainnet-beta.solana.com
RPC_ENDPOINT_BACKUP_2=https://solana-mainnet.g.alchemy.com/v2/your_alchemy_key

# Commitment level for transactions (confirmed, finalized, processed)
COMMITMENT_LEVEL=confirmed

# ===== TRADING CONFIGURATION =====
# Maximum SOL amount to trade per position
MAX_TRADE_AMOUNT=0.1

# Take profit percentage (e.g., 0.2 = 20%)
TAKE_PROFIT_PERCENTAGE=0.2

# Stop loss percentage (e.g., 0.1 = 10%)
STOP_LOSS_PERCENTAGE=0.1

# Slippage tolerance (e.g., 0.05 = 5%)
SLIPPAGE_TOLERANCE=0.05

# ===== AI CONFIGURATION =====
# Azure OpenAI configuration (preferred for enterprise)
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name

# Alternative OpenAI configuration
OPENAI_API_KEY=your_openai_api_key

# ===== SOCIAL MEDIA CONFIGURATION =====
# Twitter/X API keys for sentiment analysis
TWITTER_BEARER_TOKEN=your_twitter_bearer_token
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret

# ===== RISK MANAGEMENT =====
# Maximum portfolio exposure (e.g., 0.8 = 80%)
MAX_PORTFOLIO_EXPOSURE=0.8

# Maximum position size percentage
MAX_POSITION_SIZE_PERCENTAGE=0.1

# Minimum liquidity threshold (USD)
MIN_LIQUIDITY_THRESHOLD=50000

# ===== JUPITER DEX CONFIGURATION =====
# Jupiter API settings
JUPITER_API_URL=https://quote-api.jup.ag/v6
JUPITER_TIMEOUT=30000
JUPITER_RETRY_ATTEMPTS=3
JUPITER_RETRY_DELAY=1000

# ===== HELIUS API CONFIGURATION =====
# Enhanced Helius settings
HELIUS_API_KEY=your_helius_api_key
HELIUS_WEBHOOK_URL=https://api.helius.xyz/v0/webhooks
HELIUS_TIMEOUT=15000

# ===== DEBUGGING =====
# Enable debug mode (true/false)
DEBUG_MODE=false

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# ===== PERFORMANCE SETTINGS =====
# Cache durations (milliseconds)
CACHE_DURATION=120000  # 2 minutes
PRICE_CACHE_DURATION=300000  # 5 minutes
BALANCE_CACHE_DURATION=60000  # 1 minute

# Rate limiting
MAX_REQUESTS_PER_MINUTE=100
CONCURRENT_REQUESTS=5

# ===== SERVER CONFIGURATION =====
# Backend server port
BACKEND_PORT=8000

# Frontend server port
FRONTEND_PORT=3000

# WebSocket configuration
WEBSOCKET_HEARTBEAT_INTERVAL=30000

# ===== SCANNER CONFIGURATION =====
# Meme scanner settings
SCAN_INTERVAL=5000  # 5 seconds
MAX_TOKENS_PER_SCAN=100
MIN_MARKET_CAP=10000  # Minimum market cap in USD

# Whale tracker settings
WHALE_THRESHOLD=100  # SOL threshold for whale transactions
WHALE_SCAN_INTERVAL=10000  # 10 seconds

# ===== SECURITY =====
# API rate limiting
RATE_LIMIT_WINDOW=60000  # 1 minute
RATE_LIMIT_MAX_REQUESTS=1000

# CORS settings
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ===== OPTIONAL INTEGRATIONS =====
# Birdeye API for additional price data
BIRDEYE_API_KEY=your_birdeye_api_key

# CoinGecko API for market data
COINGECKO_API_KEY=your_coingecko_api_key

# DexScreener API for DEX data
DEXSCREENER_API_KEY=your_dexscreener_api_key

# ===== NOTIFICATION SETTINGS =====
# Discord webhook for alerts (optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url

# Telegram bot for notifications (optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ===== DATABASE CONFIGURATION =====
# SQLite database path
DATABASE_PATH=./portfolio.db

# Database connection pool settings
DB_POOL_SIZE=10
DB_TIMEOUT=30000
